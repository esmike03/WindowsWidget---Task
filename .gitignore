# Dependencies — reinstall with `npm install`
node_modules/

# Build output — ship the installer as a GitHub Release asset, not in the repo
dist/
out/

# Note: assets/icon.* and assets/tray.png are generated by `npm run icon` but are
# committed on purpose, so a fresh clone runs with `npm install && npm start`.

# Logs / editor / OS cruft
*.log
npm-debug.log*
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Local-only Claude Code settings
.claude/settings.local.json
